generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Pharmacie (scope multi-tenant)
// ─────────────────────────────────────────────────────────────

// Chaque pharmacie est le scope (tenant) de toutes les données opérationnelles.
// pharmacieId est toujours résolu depuis le token JWT vérifié côté serveur, jamais
// depuis un paramètre client — même garde que SHOPAY (`resolveBoutique`). Une
// hiérarchie Organisation → plusieurs Pharmacies (succursales) n'est volontairement
// pas modélisée tant qu'aucun client réel n'a plus d'une pharmacie : sur-ingénierie
// prématurée, même principe que la décision marketplace de SHOPAY.
model Pharmacie {
  id                         String   @id @default(cuid())
  nom                        String
  adresse                    String?
  telephone                  String?
  email                      String?
  nif                        String?
  devise                     String   @default("HTG")
  prefixeFacture             String   @default("FAC")
  seuilAlertePeremptionJours Int      @default(90)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  utilisateurs   Utilisateur[]
  categories     Categorie[]
  produits       Produit[]
  fournisseurs   Fournisseur[]
  commandesAchat CommandeAchat[]
  ventes         Vente[]
  caisseSessions CaisseSession[]
  clients        Client[]
  depenses       Depense[]
  retours        Retour[]
  inventaires    Inventaire[]
  ordonnances    Ordonnance[]
  notifications  Notification[]

  @@map("pharmacies")
}

// ─────────────────────────────────────────────────────────────
// Utilisateurs & Auth
// ─────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN // accès complet + administration (technique)
  GERANT // administration métier (paramètres, utilisateurs, tout accès)
  PHARMACIEN // valide les ordonnances, accès complet aux opérations métier
  VENDEUR // vente / POS uniquement
  MAGASINIER // stock / réception uniquement
}

model Utilisateur {
  id                 String    @id @default(cuid())
  pharmacieId        String
  email              String    @unique
  motDePasse         String
  nom                String
  prenom             String
  telephone          String?
  role               Role
  actif              Boolean   @default(true)
  // Verrouillage de compte après échecs répétés (Phase 9), au-delà du rate limiting déjà en
  // place sur la route de login : celui-ci protège l'IP contre le brute-force générique, ceci
  // protège un COMPTE précis même depuis des IP différentes.
  tentativesEchouees Int       @default(0)
  verrouilleJusqua   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  pharmacie          Pharmacie        @relation(fields: [pharmacieId], references: [id])
  refreshTokens      RefreshToken[]
  mouvementsStock    MouvementStock[]
  ventesRealisees    Vente[]          @relation("VenteCaissier")
  auditLogs          AuditLog[]
  caissesOuvertes    CaisseSession[]  @relation("CaisseOuverture")
  caissesFermees     CaisseSession[]  @relation("CaisseFermeture")
  commandesCreees    CommandeAchat[]  @relation("CommandeCreateur")
  depenses           Depense[]
  retoursCrees       Retour[]         @relation("RetourCreateur")
  inventairesCrees   Inventaire[]     @relation("InventaireCreateur")
  inventairesValides Inventaire[]     @relation("InventaireValidateur")

  @@index([pharmacieId])
  @@map("utilisateurs")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique // haché SHA-256, jamais le JWT en clair
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  utilisateur Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────
// Catalogue & Stock
// ─────────────────────────────────────────────────────────────

enum FormePharmaceutique {
  COMPRIME
  GELULE
  SIROP
  INJECTABLE
  POMMADE_CREME
  SUPPOSITOIRE
  SACHET
  GOUTTE
  SOLUTE
  AUTRE
}

model Categorie {
  id          String   @id @default(cuid())
  pharmacieId String
  nom         String
  description String?
  createdAt   DateTime @default(now())

  pharmacie Pharmacie @relation(fields: [pharmacieId], references: [id])
  produits  Produit[]

  @@unique([pharmacieId, nom])
  @@index([pharmacieId])
  @@map("categories")
}

model Produit {
  id                  String              @id @default(cuid())
  pharmacieId         String
  nom                 String
  dci                 String? // dénomination commune internationale (molécule)
  dosage              String?
  formePharmaceutique FormePharmaceutique @default(AUTRE)
  codeBarres          String?
  categorieId         String?
  prixAchat           Decimal             @db.Decimal(12, 2) // dernier prix d'achat unitaire connu
  prixVente           Decimal             @db.Decimal(12, 2)
  seuilAlerte         Int                 @default(10) // alerte stock bas sur la quantité totale
  necessiteOrdonnance Boolean             @default(false)
  substanceControlee  Boolean             @default(false)
  actif               Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  pharmacie         Pharmacie            @relation(fields: [pharmacieId], references: [id])
  categorie         Categorie?           @relation(fields: [categorieId], references: [id])
  lots              LotProduit[]
  mouvements        MouvementStock[]
  lignesCommande    LigneCommandeAchat[]
  lignesVente       LigneVente[]
  retourItems       RetourItem[]
  prescriptionItems PrescriptionItem[]

  @@unique([pharmacieId, codeBarres])
  @@index([pharmacieId])
  @@index([categorieId])
  @@index([nom])
  @@map("produits")
}

// Un lot = une entrée physique en stock (numéro de lot + date de péremption).
// La quantité en stock d'un produit est TOUJOURS la somme de LotProduit.quantiteActuelle,
// jamais un compteur séparé sur Produit — pour ne jamais pouvoir diverger.
// Pas de pharmacieId direct : le scope est toujours hérité via `produit.pharmacieId`
// (même principe que les tables enfant de SHOPAY, ex. OrderItem sans boutiqueId redondant).
model LotProduit {
  id                String   @id @default(cuid())
  produitId         String
  numeroLot         String
  dateExpiration    DateTime
  quantiteInitiale  Int
  quantiteActuelle  Int
  prixAchatUnitaire Decimal  @db.Decimal(12, 2)
  fournisseurId     String?
  createdAt         DateTime @default(now())

  produit         Produit          @relation(fields: [produitId], references: [id])
  fournisseur     Fournisseur?     @relation(fields: [fournisseurId], references: [id])
  mouvements      MouvementStock[]
  lignesVente     LigneVente[]
  retourItems     RetourItem[]
  inventaireItems InventaireItem[]

  @@unique([produitId, numeroLot])
  @@index([produitId])
  @@index([dateExpiration])
  @@map("lots_produits")
}

enum TypeMouvementStock {
  ENTREE_ACHAT
  SORTIE_VENTE
  ANNULATION_VENTE // restitution de stock suite à l'annulation d'une vente
  AJUSTEMENT_POSITIF
  AJUSTEMENT_NEGATIF
  PEREMPTION
  RETOUR_FOURNISSEUR // la pharmacie retourne un produit au fournisseur (stock -)
  RETOUR_CLIENT // un client rapporte un produit acheté (stock +), symétrique de RETOUR_FOURNISSEUR
}

// Journal append-only de tout changement de quantité, avec l'état avant/après —
// jamais réécrit, jamais supprimé (même principe qu'ASSOCOTISE/GESCOM).
// Scope hérité via `produit.pharmacieId`, pas de champ redondant.
model MouvementStock {
  id            String             @id @default(cuid())
  produitId     String
  lotId         String?
  type          TypeMouvementStock
  quantite      Int // toujours positif, le sens est porté par `type`
  quantiteAvant Int
  quantiteApres Int
  motif         String?
  utilisateurId String
  createdAt     DateTime           @default(now())

  produit     Produit     @relation(fields: [produitId], references: [id])
  lot         LotProduit? @relation(fields: [lotId], references: [id])
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])

  @@index([produitId])
  @@index([createdAt])
  @@map("mouvements_stock")
}

// ─────────────────────────────────────────────────────────────
// Fournisseurs & Achats
// ─────────────────────────────────────────────────────────────

model Fournisseur {
  id          String   @id @default(cuid())
  pharmacieId String
  nom         String
  contact     String?
  telephone   String?
  email       String?
  adresse     String?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())

  pharmacie Pharmacie       @relation(fields: [pharmacieId], references: [id])
  lots      LotProduit[]
  commandes CommandeAchat[]
  retours   Retour[]

  @@index([pharmacieId])
  @@map("fournisseurs")
}

enum StatutCommandeAchat {
  BROUILLON
  ENVOYEE
  RECUE_PARTIELLE
  RECUE_COMPLETE
  ANNULEE
}

model CommandeAchat {
  id            String              @id @default(cuid())
  pharmacieId   String
  numero        String
  fournisseurId String
  statut        StatutCommandeAchat @default(BROUILLON)
  creeParId     String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  pharmacie   Pharmacie            @relation(fields: [pharmacieId], references: [id])
  fournisseur Fournisseur          @relation(fields: [fournisseurId], references: [id])
  creePar     Utilisateur          @relation("CommandeCreateur", fields: [creeParId], references: [id])
  lignes      LigneCommandeAchat[]

  @@unique([pharmacieId, numero])
  @@index([pharmacieId])
  @@index([fournisseurId])
  @@map("commandes_achat")
}

model LigneCommandeAchat {
  id                String  @id @default(cuid())
  commandeId        String
  produitId         String
  quantiteCommandee Int
  quantiteRecue     Int     @default(0)
  prixUnitaire      Decimal @db.Decimal(12, 2)

  commande CommandeAchat @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produit  Produit       @relation(fields: [produitId], references: [id])

  @@index([commandeId])
  @@map("lignes_commande_achat")
}

// ─────────────────────────────────────────────────────────────
// Clients
// ─────────────────────────────────────────────────────────────

model Client {
  id            String    @id @default(cuid())
  pharmacieId   String
  nom           String
  prenom        String?
  telephone     String?
  email         String?
  adresse       String?
  dateNaissance DateTime?
  sexe          String? // "M" / "F", texte libre volontairement plutôt qu'un enum strict
  notes         String?
  createdAt     DateTime  @default(now())

  pharmacie   Pharmacie    @relation(fields: [pharmacieId], references: [id])
  ventes      Vente[]
  ordonnances Ordonnance[]

  @@index([pharmacieId])
  @@map("clients")
}

// ─────────────────────────────────────────────────────────────
// Ventes / POS & Ordonnances
// ─────────────────────────────────────────────────────────────

enum StatutVente {
  COMPLETEE
  ANNULEE
}

enum ModePaiement {
  ESPECES
  CARTE
  VIREMENT
  CHEQUE
  MOBILE_MONEY
  CREDIT
  AUTRE
}

model Vente {
  id              String      @id @default(cuid())
  pharmacieId     String
  numero          String
  caisseSessionId String
  caissierId      String
  clientId        String?
  ordonnanceId    String?
  statut          StatutVente @default(COMPLETEE)
  sousTotal       Decimal     @db.Decimal(12, 2)
  remise          Decimal     @default(0) @db.Decimal(12, 2)
  montantTotal    Decimal     @db.Decimal(12, 2)
  annuleeParId    String?
  annuleeLe       DateTime?
  motifAnnulation String?
  createdAt       DateTime    @default(now())

  pharmacie     Pharmacie     @relation(fields: [pharmacieId], references: [id])
  caisseSession CaisseSession @relation(fields: [caisseSessionId], references: [id])
  caissier      Utilisateur   @relation("VenteCaissier", fields: [caissierId], references: [id])
  client        Client?       @relation(fields: [clientId], references: [id])
  // Non unique : la même ordonnance peut être référencée par plusieurs ventes au fil des visites
  // (service partiel), contrairement à l'ancienne relation 1:1 possédée par une seule vente.
  ordonnance    Ordonnance?   @relation(fields: [ordonnanceId], references: [id])
  lignes        LigneVente[]
  paiements     Paiement[]
  retours       Retour[]

  @@unique([pharmacieId, numero])
  @@index([pharmacieId])
  @@index([caisseSessionId])
  @@index([caissierId])
  @@index([clientId])
  @@index([ordonnanceId])
  @@index([createdAt])
  @@map("ventes")
}

model LigneVente {
  id           String  @id @default(cuid())
  venteId      String
  produitId    String
  lotId        String
  quantite     Int
  prixUnitaire Decimal @db.Decimal(12, 2)

  vente   Vente      @relation(fields: [venteId], references: [id], onDelete: Cascade)
  produit Produit    @relation(fields: [produitId], references: [id])
  lot     LotProduit @relation(fields: [lotId], references: [id])

  @@index([venteId])
  @@map("lignes_vente")
}

// Une vente peut être réglée en plusieurs moyens de paiement à la fois (paiement scindé),
// et ce modèle est pensé pour être réutilisé par les achats/dépenses dans les phases suivantes.
model Paiement {
  id        String       @id @default(cuid())
  venteId   String
  mode      ModePaiement
  montant   Decimal      @db.Decimal(12, 2)
  createdAt DateTime     @default(now())

  vente Vente @relation(fields: [venteId], references: [id], onDelete: Cascade)

  @@index([venteId])
  @@map("paiements")
}

enum StatutOrdonnance {
  ENREGISTREE // aucun produit encore délivré
  PARTIELLEMENT_SERVIE
  SERVIE
  ANNULEE
}

// Une ordonnance médicale, désormais une entité autonome (Phase 3) plutôt que possédée 1:1 par
// une vente : elle peut être enregistrée à l'avance (le patient revient plus tard) et servie en
// plusieurs fois (service partiel), plusieurs Vente pouvant donc référencer la même ordonnance
// au fil des visites. `pieceJointeUrl` réutilise le même stockage disque local que
// REYINYON/gros-morne (pas de service tiers).
model Ordonnance {
  id               String           @id @default(cuid())
  pharmacieId      String
  numero           String
  medecinNom       String
  patientNom       String
  patientTelephone String?
  clientId         String?
  dateEmission     DateTime
  statut           StatutOrdonnance @default(ENREGISTREE)
  pieceJointeUrl   String?
  createdAt        DateTime         @default(now())

  pharmacie Pharmacie          @relation(fields: [pharmacieId], references: [id])
  client    Client?            @relation(fields: [clientId], references: [id])
  items     PrescriptionItem[]
  ventes    Vente[]

  @@unique([pharmacieId, numero])
  @@index([pharmacieId])
  @@map("ordonnances")
}

// Une ligne prescrite. `produitId` nullable : le médicament prescrit n'est pas toujours dans le
// catalogue de cette pharmacie (prescription générique, ou molécule non stockée) — `medicamentNom`
// reste alors la seule source, en texte libre.
model PrescriptionItem {
  id                String  @id @default(cuid())
  ordonnanceId      String
  produitId         String?
  medicamentNom     String
  dosage            String?
  posologie         String?
  dureeJours        Int?
  quantitePrescrite Int
  quantiteServie    Int     @default(0)
  instructions      String?

  ordonnance Ordonnance @relation(fields: [ordonnanceId], references: [id], onDelete: Cascade)
  produit    Produit?   @relation(fields: [produitId], references: [id])

  @@index([ordonnanceId])
  @@map("prescription_items")
}

// ─────────────────────────────────────────────────────────────
// Caisse & Audit
// ─────────────────────────────────────────────────────────────

enum StatutCaisse {
  OUVERTE
  FERMEE
}

model CaisseSession {
  id               String       @id @default(cuid())
  pharmacieId      String
  statut           StatutCaisse @default(OUVERTE)
  montantOuverture Decimal      @db.Decimal(12, 2)
  montantFermeture Decimal?     @db.Decimal(12, 2) // saisi par l'utilisateur à la fermeture (comptage physique)
  soldeTheorique   Decimal?     @db.Decimal(12, 2) // calculé à la fermeture : ouverture + espèces encaissées + entrées - sorties
  ecart            Decimal?     @db.Decimal(12, 2) // montantFermeture - soldeTheorique
  ouvertParId      String
  fermeeParId      String?
  ouverteLe        DateTime     @default(now())
  fermeeLe         DateTime?

  pharmacie    Pharmacie           @relation(fields: [pharmacieId], references: [id])
  ouvertePar   Utilisateur         @relation("CaisseOuverture", fields: [ouvertParId], references: [id])
  fermeePar    Utilisateur?        @relation("CaisseFermeture", fields: [fermeeParId], references: [id])
  ventes       Vente[]
  transactions CaisseTransaction[]
  depenses     Depense[]

  @@index([pharmacieId])
  @@map("caisse_sessions")
}

enum TypeCaisseTransaction {
  VENTE // encaissement espèces d'une vente (seul le volet ESPECES d'un paiement scindé)
  SORTIE_MANUELLE
  ENTREE_MANUELLE
}

// Journal append-only des mouvements de caisse physique (espèces uniquement — carte/mobile
// money ne touchent jamais le tiroir-caisse), utilisé pour calculer le solde théorique à
// la fermeture. Même principe append-only que MouvementStock.
model CaisseTransaction {
  id              String                @id @default(cuid())
  caisseSessionId String
  type            TypeCaisseTransaction
  montant         Decimal               @db.Decimal(12, 2) // toujours positif, le sens est porté par `type`
  motif           String?
  venteId         String?
  utilisateurId   String
  createdAt       DateTime              @default(now())

  caisseSession CaisseSession @relation(fields: [caisseSessionId], references: [id])

  @@index([caisseSessionId])
  @@map("caisse_transactions")
}

// pharmacieId volontairement absent ici : dérivé de `utilisateur.pharmacieId` au moment
// de la lecture si besoin plus tard (Phase 9). Le journal reste valable même pour un
// utilisateur supprimé (utilisateurId nullable), donc pas de FK directe fiable à 100 %.
model AuditLog {
  id            String   @id @default(cuid())
  utilisateurId String?
  action        String
  entite        String
  entiteId      String?
  details       Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  utilisateur Utilisateur? @relation(fields: [utilisateurId], references: [id])

  @@index([entite, entiteId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// Dépenses
// ─────────────────────────────────────────────────────────────

enum CategorieDepense {
  LOYER
  ELECTRICITE
  INTERNET
  TRANSPORT
  SALAIRES
  FOURNITURES
  MAINTENANCE
  AUTRES
}

// Une dépense en ESPECES exige une session de caisse ouverte (même garde que les ventes) et
// crée automatiquement une CaisseTransaction SORTIE_MANUELLE — pas de double comptabilité,
// le solde théorique de la caisse (caisse.service.fermer) reste la seule source de vérité.
// Les autres modes de paiement (virement, chèque...) n'affectent jamais le tiroir-caisse.
model Depense {
  id              String           @id @default(cuid())
  pharmacieId     String
  categorie       CategorieDepense
  montant         Decimal          @db.Decimal(12, 2)
  description     String?
  modePaiement    ModePaiement
  caisseSessionId String?
  utilisateurId   String
  createdAt       DateTime         @default(now())

  pharmacie     Pharmacie      @relation(fields: [pharmacieId], references: [id])
  caisseSession CaisseSession? @relation(fields: [caisseSessionId], references: [id])
  utilisateur   Utilisateur    @relation(fields: [utilisateurId], references: [id])

  @@index([pharmacieId])
  @@index([createdAt])
  @@map("depenses")
}

// ─────────────────────────────────────────────────────────────
// Retours
// ─────────────────────────────────────────────────────────────

enum TypeRetour {
  RETOUR_CLIENT // le client rapporte un produit acheté (stock +)
  RETOUR_FOURNISSEUR // la pharmacie retourne un produit défectueux/périmé au fournisseur (stock -)
  PRODUIT_ENDOMMAGE // perte interne, casse (stock -)
  PRODUIT_EXPIRE // perte interne, péremption constatée (stock -)
  ERREUR_VENTE // correction ponctuelle sans annuler toute la vente (stock +)
}

model Retour {
  id            String     @id @default(cuid())
  pharmacieId   String
  numero        String
  type          TypeRetour
  venteId       String? // RETOUR_CLIENT / ERREUR_VENTE, si rattaché à une vente précise
  fournisseurId String? // RETOUR_FOURNISSEUR
  motif         String?
  utilisateurId String
  createdAt     DateTime   @default(now())

  pharmacie   Pharmacie    @relation(fields: [pharmacieId], references: [id])
  vente       Vente?       @relation(fields: [venteId], references: [id])
  fournisseur Fournisseur? @relation(fields: [fournisseurId], references: [id])
  utilisateur Utilisateur  @relation("RetourCreateur", fields: [utilisateurId], references: [id])
  lignes      RetourItem[]

  @@unique([pharmacieId, numero])
  @@index([pharmacieId])
  @@map("retours")
}

// Chaque ligne cible un lot précis : le sens du mouvement de stock (+ ou -) est dérivé du
// `type` du retour parent, jamais saisi par le client — même garde que les autres mouvements.
model RetourItem {
  id        String @id @default(cuid())
  retourId  String
  produitId String
  lotId     String
  quantite  Int

  retour  Retour     @relation(fields: [retourId], references: [id], onDelete: Cascade)
  produit Produit    @relation(fields: [produitId], references: [id])
  lot     LotProduit @relation(fields: [lotId], references: [id])

  @@index([retourId])
  @@map("retour_items")
}

// ─────────────────────────────────────────────────────────────
// Inventaire
// ─────────────────────────────────────────────────────────────

enum TypeInventaire {
  COMPLET
  PARTIEL
}

enum StatutInventaire {
  EN_COURS
  VALIDE
  ANNULE
}

// Un inventaire fige la quantité théorique de chaque lot au moment de sa création (COMPLET =
// tous les lots actifs de la pharmacie, PARTIEL = une sélection). La validation compare à la
// quantité réelle saisie et génère les AJUSTEMENT_POSITIF/NEGATIF correspondants en réutilisant
// stock.service.ajuster — jamais de double logique d'ajustement.
model Inventaire {
  id          String           @id @default(cuid())
  pharmacieId String
  numero      String
  type        TypeInventaire
  statut      StatutInventaire @default(EN_COURS)
  creeParId   String
  valideParId String?
  valideLe    DateTime?
  createdAt   DateTime         @default(now())

  pharmacie Pharmacie        @relation(fields: [pharmacieId], references: [id])
  creePar   Utilisateur      @relation("InventaireCreateur", fields: [creeParId], references: [id])
  validePar Utilisateur?     @relation("InventaireValidateur", fields: [valideParId], references: [id])
  lignes    InventaireItem[]

  @@unique([pharmacieId, numero])
  @@index([pharmacieId])
  @@map("inventaires")
}

model InventaireItem {
  id                String  @id @default(cuid())
  inventaireId      String
  lotId             String
  quantiteTheorique Int
  quantiteReelle    Int?
  motif             String?

  inventaire Inventaire @relation(fields: [inventaireId], references: [id], onDelete: Cascade)
  lot        LotProduit @relation(fields: [lotId], references: [id])

  @@index([inventaireId])
  @@map("inventaire_items")
}

// ─────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────

enum TypeNotification {
  STOCK_BAS
  PEREMPTION_PROCHE
  COMMANDE_RECUE
}

// Formalise les alertes déjà calculées à la volée (stock.service.alertesStockBas/alertesPeremption)
// en enregistrements consultables et marquables lus — sans scheduler (aucun projet du portefeuille
// n'en a), synchronisées paresseusement à chaque lecture de la liste (notification.service.synchroniser).
// `lienEntite` porte l'id du produit/lot concerné, utilisé pour dédupliquer (jamais deux
// notifications non lues du même type pour la même entité) et pour la navigation au clic.
// Prête pour un canal email/SMS futur — non branché tant qu'aucun besoin réel ne se présente.
model Notification {
  id          String           @id @default(cuid())
  pharmacieId String
  type        TypeNotification
  titre       String
  message     String
  lienEntite  String?
  lue         Boolean          @default(false)
  createdAt   DateTime         @default(now())

  pharmacie Pharmacie @relation(fields: [pharmacieId], references: [id])

  @@index([pharmacieId])
  @@index([lue])
  @@map("notifications")
}
