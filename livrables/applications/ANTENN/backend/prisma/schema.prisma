// ANTENN — Régie TV pour chaîne de streaming FAST (Haitech Solutions)
// Prisma Schema — PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  ADMINISTRATEUR
  OPERATEUR_REGIE
}

enum TypeContenu {
  VIDEO_BOUCLE
  SPOT_PUBLICITAIRE
  HABILLAGE_LOGO
}

enum TypeCreneau {
  PROGRAMME
  MATCH_DIRECT
  PUB
}

enum StatutDiffusionMatch {
  PLANIFIE
  EN_COURS
  TERMINE
}

enum TypePackageSponsor {
  TITRE_MATCH
  BANDEAU
  HABILLAGE_PERMANENT
}

// Distingue une grille encore en cours d'édition (BROUILLON) de ce qui a été
// répercuté vers ErsatzTV (SYNCHRONISE) — cf. src/integrations/ersatztv.ts.
enum SyncStatus {
  BROUILLON
  SYNCHRONISE
}

// Un replay n'est jamais public par accident : il naît BROUILLON et un opérateur le
// publie explicitement (droits VOD à vérifier, URL d'enregistrement à saisir pour un
// match). RETIRE conserve la fiche sans l'exposer.
enum StatutReplay {
  BROUILLON
  PUBLIE
  RETIRE
}

enum PositionOverlay {
  HAUT_GAUCHE
  HAUT_DROITE
  BAS_GAUCHE
  BAS_DROITE
}

// Provenance d'une session d'audience — le rapport sponsor distingue le player web
// du player mobile, les deux n'ayant pas la même valeur commerciale.
enum SourceAudience {
  WEB
  MOBILE
}

// Actions tracées au journal d'audit. Volontairement centrées sur ce qui engage la
// chaîne vis-à-vis d'un tiers (contrat sponsor, habillage réellement à l'antenne,
// grille, comptes) plutôt que sur toute écriture.
enum ActionAudit {
  CONNEXION
  CRENEAU_CREE
  CRENEAU_MODIFIE
  CRENEAU_SUPPRIME
  CRENEAU_SYNCHRONISE
  SPONSOR_CREE
  SPONSOR_MODIFIE
  SPONSOR_SUPPRIME
  HABILLAGE_CREE
  HABILLAGE_SUPPRIME
  CONFIG_CHAINE_MODIFIEE
  CONTENU_SUPPRIME
  REPLAY_PUBLIE
  REPLAY_RETIRE
  REPLAY_SUPPRIME
  UTILISATEUR_CREE
  UTILISATEUR_MODIFIE
  UTILISATEUR_MOT_DE_PASSE_REINITIALISE
  MATCH_DEMARRE
  MATCH_TERMINE
}

// ─────────────────────────────────────────
// CONFIGURATION DE LA CHAÎNE (singleton)
// ─────────────────────────────────────────

// Identité de la chaîne : nom + logo permanent affiché en continu par le player,
// indépendamment du programme (le "bug" d'une vraie chaîne TV). Une seule ligne
// (singleton géré en service via getOrCreate).
model ConfigChaine {
  id           String          @id @default(cuid())
  // Verrou du singleton au niveau base : toujours `true`, contrainte d'unicité.
  // Sans lui, deux appels concurrents à getConfig() sur une base neuve créent
  // chacun leur ligne (findFirst ne voit rien, les deux insèrent) et le logo de
  // chaîne apparaît ou disparaît selon la ligne que findFirst renvoie ensuite.
  singleton    Boolean         @unique @default(true)
  nomChaine    String          @default("ANTENN")
  logoUrl      String?
  logoPosition PositionOverlay @default(HAUT_DROITE)
  logoOpacite  Float           @default(0.9)
  logoActif    Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("config_chaine")
}

// ─────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nom       String
  role      Role     @default(OPERATEUR_REGIE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]

  @@map("users")
}

// Réinitialisation de mot de passe. Le jeton n'est jamais stocké en clair (SHA-256 du
// jeton opaque envoyé au porteur), à usage unique et court : sans cela, un opérateur
// qui perd son mot de passe reste bloqué jusqu'à une intervention directe en base.
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────
// SPONSORS
// ─────────────────────────────────────────

model Sponsor {
  id                String              @id @default(cuid())
  nomSponsor        String
  logoUrl           String?
  typePackage       TypePackageSponsor
  contactNom        String?
  contactTelephone  String?
  dateDebutContrat  DateTime
  dateFinContrat    DateTime
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  contenus         Contenu[]
  matchsTitre      Match[]
  incrustations    IncrustationLogo[]

  @@map("sponsors")
}

// ─────────────────────────────────────────
// CONTENUS
// ─────────────────────────────────────────

model Contenu {
  id             String      @id @default(cuid())
  titre          String
  typeContenu    TypeContenu
  urlFichier     String
  dureeSecondes  Int
  sponsorId      String?
  sponsor        Sponsor?    @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  // Contenu de repli (filet anti-écran-noir) : rejoué comme "à l'antenne" quand la
  // grille synchronisée a un trou. Au plus un actif à la fois (invariant en service).
  estContenuDeRepli Boolean  @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  creneaux CreneauGrille[]

  @@map("contenus")
}

// ─────────────────────────────────────────
// MATCHS
// ─────────────────────────────────────────

model Match {
  id                  String                @id @default(cuid())
  nomEvenement        String
  equipes             String
  dateHeurePrevue     DateTime
  statutDiffusion     StatutDiffusionMatch  @default(PLANIFIE)
  ingestUrlRtmp       String?
  sponsorPrincipalId  String?
  sponsorPrincipal    Sponsor?              @relation(fields: [sponsorPrincipalId], references: [id], onDelete: SetNull)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  creneaux         CreneauGrille[]
  incrustations    IncrustationLogo[]
  bandeaux         BandeauSponsor[]
  diffusionLogs    DiffusionLog[]
  replays          Replay[]

  @@map("matchs")
}

// ─────────────────────────────────────────
// GRILLE
// ─────────────────────────────────────────

model CreneauGrille {
  id              String       @id @default(cuid())
  dateHeureDebut  DateTime
  dateHeureFin    DateTime
  typeCreneau     TypeCreneau
  contenuId       String?
  contenu         Contenu?     @relation(fields: [contenuId], references: [id], onDelete: SetNull)
  matchId         String?
  match           Match?       @relation(fields: [matchId], references: [id], onDelete: SetNull)
  syncStatus      SyncStatus   @default(BROUILLON)
  syncedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  incrustations  IncrustationLogo[]
  bandeaux       BandeauSponsor[]
  diffusionLogs  DiffusionLog[]
  replay         Replay?
  audienceSessions AudienceSession[]

  @@index([dateHeureDebut])
  @@index([dateHeureFin])
  @@map("creneaux_grille")
}

// ─────────────────────────────────────────
// HABILLAGE PUBLICITAIRE
// ─────────────────────────────────────────

model IncrustationLogo {
  id          String           @id @default(cuid())
  creneauId   String?
  creneau     CreneauGrille?   @relation(fields: [creneauId], references: [id], onDelete: Cascade)
  matchId     String?
  match       Match?           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sponsorId   String
  sponsor     Sponsor          @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  logoUrl     String
  position    PositionOverlay  @default(BAS_DROITE)
  opacite     Float            @default(0.85)
  actif       Boolean          @default(true)
  createdAt   DateTime         @default(now())

  @@map("incrustations_logo")
}

model BandeauSponsor {
  id                  String          @id @default(cuid())
  creneauId           String?
  creneau             CreneauGrille?  @relation(fields: [creneauId], references: [id], onDelete: Cascade)
  matchId             String?
  match               Match?          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  // [{ texte, logoUrl?, sponsorId }] — liste hétérogène, JSON plus simple qu'une
  // table de jointure pour un simple bandeau défilant sans besoin de requêtage fin.
  items               Json
  vitesseDefilement   Int             @default(60)
  actif               Boolean         @default(true)
  createdAt           DateTime        @default(now())

  @@map("bandeaux_sponsor")
}

// ─────────────────────────────────────────
// RAPPORTS DE DIFFUSION
// ─────────────────────────────────────────

// Preuve de diffusion d'un créneau réellement passé à l'antenne : c'est la base du
// rapport sponsor, donc du document qui justifie une facturation. Généré par
// `audience.service.synchroniserDiffusionLogs()` une fois le créneau terminé, jamais
// saisi à la main. `creneauId` est unique : c'est ce qui rend la génération idempotente
// au niveau base (deux synchronisations concurrentes ne peuvent pas doubler un log).
model DiffusionLog {
  id                       String          @id @default(cuid())
  creneauId                String?         @unique
  creneau                  CreneauGrille?  @relation(fields: [creneauId], references: [id], onDelete: SetNull)
  matchId                  String?
  match                    Match?          @relation(fields: [matchId], references: [id], onDelete: SetNull)
  dateHeureReelle          DateTime
  // Somme des secondes réellement visionnées par l'ensemble des sessions présentes
  // pendant le créneau (pas la durée du créneau : un programme d'une heure vu par
  // personne pèse 0).
  dureeVisionneeEstimee    Int
  // Nombre de sessions distinctes ayant regardé pendant le créneau.
  nombreVuesEstimees       Int
  createdAt                DateTime        @default(now())

  @@index([matchId])
  @@map("diffusion_logs")
}

// ─────────────────────────────────────────
// AUDIENCE
// ─────────────────────────────────────────

// Une session de visionnage, alimentée par le heartbeat des players (web et mobile).
// C'est la seule source de chiffres d'audience du produit : sans elle, DiffusionLog
// n'a rien à agréger et le rapport sponsor reste vide.
//
// Ce qu'elle n'est pas : une mesure d'audience certifiée. Les pings sont déclaratifs
// (émis par le client), la durée est bornée côté serveur (cf. audience.service) et le
// document sponsor doit les présenter comme des estimations, jamais comme un relevé.
//
// `sessionKey` est un identifiant opaque tiré par le player et conservé dans son
// stockage local : il n'identifie jamais une personne, aucune donnée personnelle n'est
// stockée ici. Une ligne par couple (session, créneau) : un viewer qui reste devant
// trois programmes d'affilée produit trois lignes, ce qui permet de compter les vues
// programme par programme.
model AudienceSession {
  id            String          @id @default(cuid())
  sessionKey    String
  source        SourceAudience  @default(WEB)

  // Antenne (direct) : le créneau regardé au moment du ping.
  creneauId     String?
  creneau       CreneauGrille?  @relation(fields: [creneauId], references: [id], onDelete: Cascade)
  // Replay (VOD) : exclusif du précédent.
  replayId      String?
  replay        Replay?         @relation(fields: [replayId], references: [id], onDelete: Cascade)

  debutAt       DateTime        @default(now())
  dernierPingAt DateTime        @default(now())
  dureeSecondes Int             @default(0)

  // NULL != NULL en Postgres : les deux contraintes coexistent sans se gêner, chacune
  // ne s'appliquant qu'aux lignes qui portent réellement la colonne concernée.
  @@unique([sessionKey, creneauId])
  @@unique([sessionKey, replayId])
  @@index([creneauId])
  @@index([replayId])
  @@index([dernierPingAt])
  @@map("audience_sessions")
}

// ─────────────────────────────────────────
// JOURNAL D'AUDIT
// ─────────────────────────────────────────

// Trace des actions qui engagent la chaîne vis-à-vis d'un tiers. Sur un produit qui
// facture une exposition sponsor, il faut pouvoir répondre à « qui a retiré ce bandeau
// et quand ? ». Jamais modifiable ni supprimable par l'application (aucune route
// d'écriture exposée), et l'utilisateur est conservé en clair (email/nom figés au
// moment de l'action) pour que la suppression d'un compte ne vide pas l'historique.
model AuditLog {
  id           String       @id @default(cuid())
  action       ActionAudit
  utilisateurId String?
  utilisateurEmail String
  utilisateurNom   String
  // Type et identifiant de l'objet touché (ex. "Sponsor", "cml...").
  cible        String?
  cibleId      String?
  // Contexte libre : ce qui a changé, en clair et lisible par un humain.
  details      String?
  adresseIp    String?
  createdAt    DateTime     @default(now())

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ─────────────────────────────────────────
// REPLAY / VOD
// ─────────────────────────────────────────

// Ré-écoute à la demande d'un programme déjà passé à l'antenne. Comme pour Contenu,
// ANTENN ne stocke ni ne transcode la vidéo : `urlVod` pointe vers un fichier déjà
// hébergé (CDN pour un programme, enregistrement MediaMTX pour un match direct).
// `creneauId` garde le lien avec ce qui a réellement été diffusé — c'est lui qui
// permet de rejouer l'habillage sponsor du créneau d'origine sur le replay.
model Replay {
  id            String        @id @default(cuid())
  titre         String
  description   String?
  urlVod        String
  vignetteUrl   String?
  dureeSecondes Int
  statut        StatutReplay  @default(BROUILLON)
  // Fenêtre de droits de diffusion (bornes optionnelles) : hors fenêtre, le replay
  // disparaît du catalogue public de lui-même, sans intervention d'un opérateur.
  disponibleDu  DateTime?
  disponibleAu  DateTime?
  nombreVues    Int           @default(0)
  publieAt      DateTime?
  // Un seul replay par créneau diffusé (les NULL multiples restent permis en Postgres).
  creneauId     String?        @unique
  creneau       CreneauGrille? @relation(fields: [creneauId], references: [id], onDelete: SetNull)
  matchId       String?
  match         Match?         @relation(fields: [matchId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  audienceSessions AudienceSession[]

  @@index([statut])
  @@map("replays")
}
